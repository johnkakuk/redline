{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The PWA build is served as static assets; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://txjxibgqdimywsavjjjy.supabase.co"
  },
  // Secret (set with `wrangler secret put`): SUPABASE_SECRET_KEY
  "observability": { "enabled": true }
}
